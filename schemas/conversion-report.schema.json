{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/deckflow/deckhtml/schemas/conversion-report.schema.json",
  "title": "DeckHTML Conversion Report",
  "description": "Per-element machine report emitted by @deckflow/deckhtml (DH-P0-002).",
  "type": "object",
  "required": ["schema_version", "engine", "status", "slides", "summary", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Report schema version. Bumped only on breaking changes."
    },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed"]
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "index", "elements"],
        "additionalProperties": false,
        "properties": {
          "slide_id": { "type": "string" },
          "index": { "type": "integer", "minimum": 1 },
          "elements": {
            "type": "array",
            "items": { "$ref": "#/definitions/elementRecord" }
          }
        }
      }
    },
    "summary": { "$ref": "#/definitions/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    }
  },
  "definitions": {
    "mappingMode": {
      "type": "string",
      "enum": ["native", "vector", "raster", "ignored", "unsupported"]
    },
    "elementRecord": {
      "type": "object",
      "required": ["element_id", "kind", "mapping_mode", "object_ref", "geometry", "warnings"],
      "additionalProperties": false,
      "properties": {
        "element_id": { "type": ["string", "null"] },
        "kind": { "type": "string" },
        "mapping_mode": { "$ref": "#/definitions/mappingMode" },
        "object_ref": { "type": ["string", "null"] },
        "geometry": {
          "type": "object",
          "required": ["x", "y", "w", "h", "unit"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number" },
            "h": { "type": "number" },
            "unit": { "type": "string", "enum": ["inch", "px"] }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnostic" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["native", "vector", "raster", "ignored", "unsupported"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "integer", "minimum": 0 },
        "vector": { "type": "integer", "minimum": 0 },
        "raster": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["rule_id", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "slide_id": { "type": ["string", "null"] },
        "element_id": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "recovery": { "type": ["string", "null"] }
      }
    }
  }
}
